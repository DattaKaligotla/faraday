ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Firestore + Firebase Auth verification (dashboard endpoints).
# Pick ONE of the credential options below. Order of precedence in code:
#   FIREBASE_SERVICE_ACCOUNT_BASE64 > FIREBASE_SERVICE_ACCOUNT_JSON > GOOGLE_APPLICATION_CREDENTIALS > ADC
#
# Local dev: easiest is GOOGLE_APPLICATION_CREDENTIALS pointing at a JSON file
# you `gcloud iam service-accounts keys create`-d.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# Vercel / serverless: paste the JSON itself. Use BASE64 if your platform's
# env-var UI mangles multi-line strings (recommended for Vercel):
#   $ base64 -i ./service-account.json | pbcopy
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Or paste the raw JSON (one line, with private_key newlines as literal \n):
# FIREBASE_SERVICE_ACCOUNT_JSON=

FIREBASE_PROJECT_ID=faraday-49784

# GitHub App — create one at https://github.com/settings/apps
# The App's Setup URL must point at /api/integration/github/setup on FRONTEND_URL.
# The App's Webhook URL must point at /api/webhooks/github on a publicly reachable
# host (use smee.io or `gh webhook forward` for local development).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=         # full PEM. If multiline storage is awkward, use literal \n
GITHUB_APP_SLUG=FaradayStack
GITHUB_WEBHOOK_SECRET=          # the secret configured in the App's webhook settings
FRONTEND_URL=http://localhost:5173

# Server-side secret used to sign install-flow state params. Any random string.
SESSION_SECRET=

# Anthropic on Bedrock — auth via static IAM user keys. The webapp mints
# short-term Bedrock bearer tokens from these on every outbound call (and
# forwards only the bearer to sandboxed runners).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# PR-job dispatch (Vercel Sandbox). All keys below are read via
# $env/static/private — the build fails outright if any are missing. Use empty
# strings only for local dev when the "Create PR" flow is unused.
FARADAY_SOURCE_TOKEN=                # Fine-grained PAT (Contents: Read) on the faraday repo
FARADAY_AGENT_REF=main               # Branch/SHA of faraday to clone into the sandbox
BLOB_READ_WRITE_TOKEN=               # Vercel Blob token for snapshot caching
FIREBASE_SERVICE_ACCOUNT_BASE64=     # Base64-encoded Firebase service-account JSON
